# =============================================================================
# Messenger Agent — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# --- Meta Messenger Platform ---
META_APP_SECRET=your-meta-app-secret
META_PAGE_ACCESS_TOKEN=your-meta-page-access-token
META_VERIFY_TOKEN=your-webhook-verify-token

# --- Telegram Reports ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- Internal API Security ---
INTERNAL_API_TOKEN=your-internal-api-token

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
APP_PORT=8080
# Public URL of the app (used in password-reset / email-change links). Add
# <APP_BASE_URL>/auth/** to Supabase → Auth → URL Configuration → Redirect URLs.
APP_BASE_URL=http://localhost:8080

# --- Cloud Run Webhook Processing Mode ---
# false = synchronous (safe for request-based billing, default)
# true  = async background tasks (only if CPU-always-allocated)
WEBHOOK_ASYNC_MODE=false

# typing_on + short human pause (1.5-3.5s) before each Messenger reply; auto-off under pytest
ENABLE_TYPING_DELAY=true

# --- Store (single-store bootstrap) ---
DEFAULT_STORE_ID=00000000-0000-0000-0000-000000000001
