# =============================================================================
# Messenger Agent — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env.
# On Render, set the same keys under the service's Environment tab.
# =============================================================================

# --- Application -------------------------------------------------------------
# development = local (enables /docs and the local dev login)
# production  = Render (the default if unset)
APP_ENV=development
# Public URL of the app, used in password-reset / email-change links.
# On Render: https://<your-service>.onrender.com. Also add <APP_BASE_URL>/auth/**
# under Supabase → Authentication → URL Configuration → Redirect URLs.
APP_BASE_URL=http://localhost:8080

# --- Supabase (required) -----------------------------------------------------
# Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only key that bypasses Row Level Security. Never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Gemini AI (required for bot replies) ------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# --- Meta Messenger Platform (required for the live bot) ---------------------
# developers.facebook.com → your app → App settings → Basic → App secret
META_APP_SECRET=your-meta-app-secret
# developers.facebook.com → your app → Messenger → API settings → Generate token
# (pick the Facebook Page the bot should answer for)
META_PAGE_ACCESS_TOKEN=your-meta-page-access-token
# Any random string you choose; enter the same value as the webhook "Verify token" in Meta
META_VERIFY_TOKEN=choose-a-random-verify-token
# Numeric ID of that Facebook Page (Page → About → Page transparency → Page ID).
# Used for the storefront's "Message us on Messenger" (m.me) links.
FACEBOOK_PAGE_ID=your-facebook-page-id

# --- Telegram (optional: nightly order report + angry-customer alerts) ------
# Create a bot with @BotFather to get the token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Send the bot a message, then open https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy "chat":{"id": ...}
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- Scheduled jobs ----------------------------------------------------------
# Secret the nightly report job sends in the X-Internal-Token header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If empty, POST /internal/daily-report refuses every request.
INTERNAL_API_TOKEN=generate-a-long-random-token

# --- Behaviour ---------------------------------------------------------------
# typing_on + short human pause (1.5-3.5s) before each Messenger reply; auto-off under pytest
ENABLE_TYPING_DELAY=true

# --- Store (single-store bootstrap; matches migrations/002_seed_data.sql) ----
DEFAULT_STORE_ID=00000000-0000-0000-0000-000000000001
